  RED
  ORANGE
  YELLOW
  GREEN
  BLUE
  PURPLE
  GREY
}

enum StageStatus {
  PENDING
  ONGOING
  ON_HOLD
  COMPLETED
}

enum ProjectExecutionType {
  INTERNAL
  EXTERNAL
}

