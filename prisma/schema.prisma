}

enum FluxAiConversationStatus {
  ACTIVE
  ARCHIVED
}

enum FluxAiMessageRole {
  USER
  ASSISTANT
  SYSTEM_EVENT
}

model User {
  id                                  String                               @id @default(cuid())
  email                               String                               @unique
  name                                String?
  avatarUrl                           String?
  department                          String?
  phoneNumber                         String?
  jobTitle                            String?
  bio                                 String?
  passwordHash                        String
  passwordChangedAt                   DateTime?
  role                                UserRole                             @default(USER)
  projectCreationAccessGranted        Boolean                              @default(false)
  inviteToken                         String?                              @unique
  inviteExpiresAt                     DateTime?
  inviteAcceptedAt                    DateTime?
  sessions                            Session[]
  passwordResetTokens                 PasswordResetToken[]
  projects                            Project[]                            @relation("ProjectCreator")
  ownedProjects                       Project[]                            @relation("ProjectOwner")
  projectCoOwnerships                 ProjectCoOwner[]                     @relation("ProjectCoOwnerUser")
  addedProjectCoOwnerships            ProjectCoOwner[]                     @relation("ProjectCoOwnerAdder")
  revisions                           ProjectRevision[]
  reviewedRevisions                   ProjectRevision[]                    @relation("ProjectRevisionReviewer")
  comments                            ProjectComment[]
  deletedProjectComments              ProjectComment[]                     @relation("ProjectCommentDeletedBy")
  commentMentions                     ProjectCommentMention[]
  comparisonComments                  ComparisonComment[]
  attachments                         ProjectAttachment[]
  projectArchives                     ProjectArchive[]                     @relation("ProjectArchiveArchivedBy")
  archivedProjectFiles                ArchivedProjectFile[]                @relation("ArchivedProjectFileArchivedBy")
  createdArchiveArtworkMetadata       ArchiveArtworkMetadata[]             @relation("ArchiveArtworkMetadataCreatedBy")
  approvedArchiveArtworkMetadata      ArchiveArtworkMetadata[]             @relation("ArchiveArtworkMetadataApprovedBy")
  archivedArtworkMetadata             ArchiveArtworkMetadata[]             @relation("ArchiveArtworkMetadataArchivedBy")
  approvalContactWorkflows            ProjectCompletionWorkflow[]          @relation("ProjectCompletionApprovalContact")
  copyrightContactWorkflows           ProjectCompletionWorkflow[]          @relation("ProjectCompletionCopyrightContact")
  invoiceContactWorkflows             ProjectCompletionWorkflow[]          @relation("ProjectCompletionInvoiceContact")
  uploadedCompletionDocuments         ProjectCompletionDocument[]          @relation("ProjectCompletionDocumentUploadedBy")
  manualArchiveFiles                  ManualArchiveFile[]                  @relation("ManualArchiveFileUploadedBy")
  createdArchiveFileShareLinks        ArchiveFileShareLink[]               @relation("ArchiveFileShareLinkCreatedBy")
  archiveAccess                       UserArchiveAccess?                   @relation("UserArchiveAccessUser")
  archiveAssetAccesses                UserArchiveAssetAccess[]             @relation("UserArchiveAssetAccessUser")
  archiveCategoryAccesses             ArchiveCategoryAccess[]              @relation("ArchiveCategoryAccessUser")
  grantedArchiveAccesses              UserArchiveAccess[]                  @relation("UserArchiveAccessGrantedBy")
  grantedArchiveAssetAccesses         UserArchiveAssetAccess[]             @relation("UserArchiveAssetAccessGrantedBy")
  createdArchiveCategoryAccesses      ArchiveCategoryAccess[]              @relation("ArchiveCategoryAccessCreatedBy")
  fluxAiConversations                 FluxAiConversation[]
  fluxAiSearchHistory                 FluxAiSearchHistory[]
  manualLibraryAssets                 ManualLibraryAsset[]                 @relation("ManualLibraryAssetUploadedBy")
  notifications                       Notification[]
  fileFavorites                       FileFavorite[]
  manualLibraryAssetFavorites         ManualLibraryAssetFavorite[]
  activityLogs                        ProjectActivityLog[]
  createdCollaboratorVisibilityPauses ProjectCollaboratorVisibilityPause[] @relation("ProjectCollaboratorVisibilityPauseCreator")
  projectExecutorAssignments          ProjectExecutor[]                    @relation("ProjectExecutorUser")
  addedProjectExecutorAssignments     ProjectExecutor[]                    @relation("ProjectExecutorAddedBy")
  startedProjectStages                ProjectStage[]                       @relation("ProjectStageStarter")
  reviewedStageSubmissions            ProjectAttachment[]                  @relation("SubmissionReviewer")
  stageInvoiceRequestsMade            StageInvoiceRequest[]                @relation("StageInvoiceRequestRequester")
  stageInvoiceRequestsReceived        StageInvoiceRequest[]                @relation("StageInvoiceRequestRecipient")
  calendarEvents                      CalendarEvent[]
  projectCollaborations               ProjectCollaborator[]                @relation("ProjectCollaboratorUser")
  addedProjectCollaborations          ProjectCollaborator[]                @relation("ProjectCollaboratorAdder")
  calendarCollaborations              CalendarCollaborator[]               @relation("CalendarCollaboratorUser")
  addedCalendarCollaborations         CalendarCollaborator[]               @relation("CalendarCollaboratorAdder")
  createdContactDirectoryEntries      ContactDirectoryEntry[]              @relation("ContactDirectoryEntryCreator")
  projectInquiryPartySelections       ProjectInquiryParty[]                @relation("ProjectInquiryPartyUser")
  researchWorkspaces                  ProjectResearchWorkspace[]           @relation("ProjectResearchWorkspaceOwner")
  projectPrivateFolders               ProjectPrivateFolder[]               @relation("ProjectPrivateFolderOwner")
  createdResearchFolders              ProjectResearchFolder[]              @relation("ProjectResearchFolderCreator")
  addedResearchFolderFiles            ProjectResearchFolderFile[]          @relation("ProjectResearchFolderFileAdder")
  createdConceptFolders               ProjectConceptFolder[]               @relation("ProjectConceptFolderCreator")
  approvedConceptFolders              ProjectConceptFolder[]               @relation("ProjectConceptFolderApprover")
  importedStageThreeConceptReferences ProjectConceptFolder[]               @relation("ProjectConceptFolderStageThreeReferenceImporter")
  createdStageFileHandoffs            ProjectStageFileHandoff[]            @relation("ProjectStageFileHandoffCreator")
  updatedFileChecklistItems           ProjectFileChecklistItem[]           @relation("ProjectFileChecklistItemUpdater")
  fileChecklistRequestsMade           ProjectFileChecklistRequest[]        @relation("ProjectFileChecklistRequestRequester")
  fileChecklistRequestsReceived       ProjectFileChecklistRequest[]        @relation("ProjectFileChecklistRequestRecipient")
  fileChecklistRequestsResponded      ProjectFileChecklistRequest[]        @relation("ProjectFileChecklistRequestResponder")
  createdProductionUnits              ProjectProductionUnit[]              @relation("ProjectProductionUnitCreator")
  addedProductionUnitFiles            ProjectProductionUnitFile[]          @relation("ProjectProductionUnitFileAdder")
  productionApprovalAssignments       ProductionApprovalStep[]             @relation("ProductionApprovalRecipient")
  productionApprovalsRequested        ProductionApprovalStep[]             @relation("ProductionApprovalRequester")
  productionApprovalDecisions         ProductionApprovalStep[]             @relation("ProductionApprovalDecider")
  productionApprovalRemovals          ProductionApprovalStep[]             @relation("ProductionApprovalRemover")
  productionHandoversRequested        ProjectProductionHandover[]          @relation("ProjectProductionHandoverRequester")
  productionHandoverAssignments       ProjectProductionHandover[]          @relation("ProjectProductionHandoverRecipient")
  productionHandoversCompleted        ProjectProductionHandover[]          @relation("ProjectProductionHandoverCompleter")
  signedOffProductionSupervisions     ProjectProductionSupervision[]       @relation("ProjectProductionSupervisionSigner")
  createdProductionSampleRounds       ProductionSampleRound[]              @relation("ProductionSampleRoundCreator")
  completedProductionSampleRounds     ProductionSampleRound[]              @relation("ProductionSampleRoundCompleter")
  decidedPhysicalSampleRounds         ProductionSampleRound[]              @relation("ProductionSampleRoundDecider")
  productionSampleRequestAssignments  ProductionSampleRound[]              @relation("ProductionSampleRoundRecipient")
  productionSampleRoundParticipations ProductionSampleRoundParticipant[]   @relation("ProductionSampleRoundParticipantUser")
  addedProductionSampleParticipants   ProductionSampleRoundParticipant[]   @relation("ProductionSampleRoundParticipantAdder")
  addedProductionSampleEvidence       ProductionSampleRoundEvidence[]      @relation("ProductionSampleRoundEvidenceAdder")
  productionSampleFeedbackRecipients  ProductionSampleFeedback[]           @relation("ProductionSampleFeedbackRecipient")
  productionSampleFeedbackSent        ProductionSampleFeedback[]           @relation("ProductionSampleFeedbackSender")
  configuredRequestReminders          RequestReminder[]                    @relation("RequestReminderConfiguredBy")
  projectClosures                     ProjectClosure[]                     @relation("ProjectClosureCloser")
  projectFormDrafts                   ProjectFormDraft[]                   @relation("ProjectFormDraftOwner")
  createdFlexibleProjects             FlexibleProject[]                    @relation("FlexibleProjectCreator")
  ownedFlexibleProjects               FlexibleProject[]                    @relation("FlexibleProjectOwner")
  flexibleProjectCollaborations       FlexibleProjectCollaborator[]        @relation("FlexibleProjectCollaboratorUser")
  addedFlexibleProjectCollaborations  FlexibleProjectCollaborator[]        @relation("FlexibleProjectCollaboratorAdder")
  responsibleFlexibleMilestones       FlexibleMilestone[]                  @relation("FlexibleMilestoneResponsibleUser")
  completedFlexibleMilestones         FlexibleMilestone[]                  @relation("FlexibleMilestoneCompletedBy")
  authoredFlexibleMilestoneNotes      FlexibleMilestoneNote[]              @relation("FlexibleMilestoneNoteAuthor")
  uploadedFlexibleProjectAttachments  FlexibleProjectAttachment[]          @relation("FlexibleProjectAttachmentUploader")
  createdProjectTrackers              ProjectTracker[]                     @relation("ProjectTrackerCreatedBy")
  projectTrackerActivities            ProjectTrackerActivity[]             @relation("ProjectTrackerActivityActor")
  createdAt                           DateTime                             @default(now())
  updatedAt                           DateTime                             @updatedAt
}

model UserArchiveAccess {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation("UserArchiveAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  level       ArchiveAccessLevel @default(FULL)
  grantedById String?
  grantedBy   User?              @relation("UserArchiveAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([grantedById])
}

model UserArchiveAssetAccess {
  id                    String               @id @default(cuid())
  userId                String
  user                  User                 @relation("UserArchiveAssetAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  archivedProjectFileId String?
  archivedProjectFile   ArchivedProjectFile? @relation("UserArchiveAssetAccessArchivedProjectFile", fields: [archivedProjectFileId], references: [id], onDelete: Cascade)
  manualArchiveFileId   String?
  manualArchiveFile     ManualArchiveFile?   @relation("UserArchiveAssetAccessManualArchiveFile", fields: [manualArchiveFileId], references: [id], onDelete: Cascade)
  grantedById           String?
  grantedBy             User?                @relation("UserArchiveAssetAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([userId, archivedProjectFileId])
  @@unique([userId, manualArchiveFileId])
  @@index([userId])
  @@index([archivedProjectFileId])
  @@index([manualArchiveFileId])
  @@index([grantedById])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PermissionDefinition {
  id              String           @id @default(cuid())
  key             String           @unique
  label           String
  description     String
  group           String
  isSystem        Boolean          @default(true)
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RolePermission {
  id            String               @id @default(cuid())
  role          UserRole
  permissionKey String
  permission    PermissionDefinition @relation(fields: [permissionKey], references: [key], onDelete: Restrict)
  enabled       Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([role, permissionKey])
  @@index([role])
  @@index([permissionKey])
}

model Project {
  id                     String                         @id @default(cuid())
  name                   String
  category               String?
  description            String?
  executionType          ProjectExecutionType?
  budgetRequired         Boolean?
  budget                 Int?
  currency               String?
  statusId               String?
  status                 ProjectStatusOption?           @relation(fields: [statusId], references: [id], onDelete: SetNull)
  priority               ProjectPriority?
  startDate              DateTime?
  endDate                DateTime?
  currentStageName       String?
  stageCount             Int?
  ownerId                String?
  owner                  User?                          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdById            String
  createdBy              User                           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  isPinned               Boolean                        @default(false)
  stages                 ProjectStage[]
  tags                   ProjectTagAssignment[]
  revisions              ProjectRevision[]
  comments               ProjectComment[]
  comparisonComments     ComparisonComment[]
  attachments            ProjectAttachment[]
  invoiceRequests        StageInvoiceRequest[]
  activityLogs           ProjectActivityLog[]
  collaborators          ProjectCollaborator[]
  coOwners               ProjectCoOwner[]
  executors              ProjectExecutor[]
  stageFileHandoffs      ProjectStageFileHandoff[]
  fileChecklists         ProjectFileChecklist[]
  fileChecklistRequests  ProjectFileChecklistRequest[]
  productionUnits        ProjectProductionUnit[]
  productionSupervisions ProjectProductionSupervision[]
  productionSampleRounds ProductionSampleRound[]
  requestReminders       RequestReminder[]
  closure                ProjectClosure?
  archive                ProjectArchive?
  archivedFiles          ArchivedProjectFile[]
  archiveArtworkMetadata ArchiveArtworkMetadata[]
  completionWorkflow     ProjectCompletionWorkflow?
  completionDocuments    ProjectCompletionDocument[]
  workflowStages         ProjectWorkflowStage[]
  inquiry                ProjectInquiry?
  researchWorkspaces     ProjectResearchWorkspace[]
  privateFolders         ProjectPrivateFolder[]
  conceptFolders         ProjectConceptFolder[]
  formDrafts             ProjectFormDraft[]
  trackerRows            ProjectTrackerRow[]            @relation("ProjectTrackerStructuredProject")
  completedAt            DateTime?
  archivedAt             DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  @@index([statusId])
  @@index([ownerId])
  @@index([isPinned])
  @@index([createdAt])
  @@index([createdById])
}

model FlexibleProject {
  id            String                        @id @default(cuid())
  slug          String                        @unique
  name          String
  description   String?
  status        FlexibleProjectStatus         @default(ACTIVE)
  priority      ProjectPriority               @default(MEDIUM)
  scope         ProjectExecutionType          @default(INTERNAL)
  deadline      DateTime?
  ownerId       String
  owner         User                          @relation("FlexibleProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdById   String
  createdBy     User                          @relation("FlexibleProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  collaborators FlexibleProjectCollaborator[]
  milestones    FlexibleMilestone[]
  attachments   FlexibleProjectAttachment[]
  trackerRows   ProjectTrackerRow[]            @relation("ProjectTrackerFlexibleProject")
  completedAt   DateTime?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  @@index([ownerId, updatedAt])
  @@index([createdById])
  @@index([status, updatedAt])
}

model FlexibleProjectCollaborator {
  projectId String
  project   FlexibleProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation("FlexibleProjectCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  addedById String?
  addedBy   User?           @relation("FlexibleProjectCollaboratorAdder", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@id([projectId, userId])
  @@index([userId, projectId])
  @@index([addedById])
}

model FlexibleMilestone {
  id                String                      @id @default(cuid())
  projectId         String
  project           FlexibleProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  category          String?
  responsibleUserId String?
  responsibleUser   User?                       @relation("FlexibleMilestoneResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  deadline          DateTime?
  sortOrder         Int
  status            FlexibleMilestoneStatus     @default(PENDING)
  completedAt       DateTime?
  completedById     String?
  completedBy       User?                       @relation("FlexibleMilestoneCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  attachments       FlexibleProjectAttachment[]
  notes             FlexibleMilestoneNote[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([projectId, sortOrder])
  @@index([projectId, status])
  @@index([responsibleUserId])
  @@index([completedById])
}

model FlexibleMilestoneNote {
  id          String            @id @default(cuid())
  milestoneId String
  milestone   FlexibleMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  authorId    String
  author      User              @relation("FlexibleMilestoneNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  content     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([milestoneId, createdAt])
  @@index([authorId])
}

model FlexibleProjectAttachment {
  id               String             @id @default(cuid())
  projectId        String
  project          FlexibleProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId      String?
  milestone        FlexibleMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  uploadedById     String
  uploadedBy       User               @relation("FlexibleProjectAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  fileName         String
  originalFileName String
  mimeType         String
  fileSize         Int
  bucket           String
  storageKey       String             @unique
  status           AttachmentStatus   @default(UPLOADING)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([projectId, createdAt])
  @@index([milestoneId, createdAt])
  @@index([uploadedById])
  @@index([status])
}

model ProjectTracker {
  id          String                   @id @default(cuid())
  name        String                   @default("Marketing Project Tracker")
  settings    Json?
  createdById String
  createdBy   User                     @relation("ProjectTrackerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  columns     ProjectTrackerColumn[]
  rows        ProjectTrackerRow[]
  activities  ProjectTrackerActivity[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([createdAt])
  @@index([createdById])
}

model ProjectTrackerColumn {
  id             String                   @id @default(cuid())
  trackerId      String
  tracker        ProjectTracker           @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  name           String
  type           ProjectTrackerColumnType @default(TEXT)
  sourceFieldKey String?
  options        Json?
  sortOrder      Int
  width          Int                      @default(180)
  hidden         Boolean                  @default(false)
  frozen         Boolean                  @default(false)
  deletedAt      DateTime?
  cells          ProjectTrackerCell[]
  activities     ProjectTrackerActivity[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([trackerId, sortOrder])
  @@index([trackerId, deletedAt])
  @@index([sourceFieldKey])
}

model ProjectTrackerRow {
  id                  String                   @id @default(cuid())
  trackerId           String
  tracker             ProjectTracker           @relation(fields: [trackerId], references: [id], onDelete: Cascade)
