model ProjectActivityLog {
  id         String            @id @default(cuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId    String?
  stage      ProjectStage?     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  revisionId String?
  revision   ProjectRevision?  @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  actorId    String
  actor      User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     ActivityLogAction
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@index([projectId, createdAt])
  @@index([stageId, createdAt])
  @@index([revisionId, createdAt])
  @@index([actorId])
}

model ProjectArchive {
  id                String                @id @default(cuid())
  projectId         String                @unique
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  finalStageId      String?
  finalStage        ProjectStage?         @relation("ProjectArchiveFinalStage", fields: [finalStageId], references: [id], onDelete: Restrict)
  archivedById      String
  archivedBy        User                  @relation("ProjectArchiveArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  projectName       String
  projectCategory   String
  projectTag        String?
  archiveCategoryId String?
  archiveCategory   ArchiveCategory?      @relation(fields: [archiveCategoryId], references: [id], onDelete: SetNull)
  status            ArchiveRecordStatus   @default(ARCHIVED)
  archivedAt        DateTime
  files             ArchivedProjectFile[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([archiveCategoryId, archivedAt])
  @@index([archivedById])
}

model ArchivedProjectFile {
  id                   String                   @id @default(cuid())
  archiveId            String
  archive              ProjectArchive           @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  projectId            String
  project              Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAttachmentId   String
  sourceAttachment     ProjectAttachment        @relation("ArchivedProjectFileSourceAttachment", fields: [sourceAttachmentId], references: [id], onDelete: Restrict)
  sourceRevisionId     String?
  sourceRevision       ProjectRevision?         @relation("ArchivedProjectFileSourceRevision", fields: [sourceRevisionId], references: [id], onDelete: SetNull)
  finalArchiveFileName String
  originalFileName     String
  mimeType             String
  fileSize             Int
  bucket               String
  storageKey           String
  archivedById         String
  archivedBy           User                     @relation("ArchivedProjectFileArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  artworkMetadata      ArchiveArtworkMetadata?
  userArchiveAccesses  UserArchiveAssetAccess[] @relation("UserArchiveAssetAccessArchivedProjectFile")
  shareLinks           ArchiveFileShareLink[]
  archivedAt           DateTime
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([archiveId, finalArchiveFileName])
  @@unique([archiveId, sourceAttachmentId])
  @@index([projectId, archivedAt])
  @@index([sourceAttachmentId])
  @@index([sourceRevisionId])
  @@index([archivedById])
}

model ArchiveArtworkMetadata {
  id                  String                           @id @default(cuid())
  sourceType          ArchiveArtworkMetadataSourceType @default(PROJECT_FINAL_FILE)
  archiveFileId       String?                          @unique
  archiveFile         ArchivedProjectFile?             @relation(fields: [archiveFileId], references: [id], onDelete: Cascade)
  manualArchiveFileId String?                          @unique
  manualArchiveFile   ManualArchiveFile?               @relation(fields: [manualArchiveFileId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project?                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAttachmentId  String?
  sourceAttachment    ProjectAttachment?               @relation("ArchiveArtworkMetadataSourceAttachment", fields: [sourceAttachmentId], references: [id], onDelete: Restrict)
  artworkId           String
  titleWorkingName    String
  versionRevision     String
  languageMarket      String
  artworkType         String
  brandSubBrand       String
  productSku          String?
  campaignProject     String?
  formatDimensions    String?
  colourSpace         String
  resolution          String?
  fileFormats         String
  printProcess        String?
  specialFinishes     String?
  creationDate        DateTime
  lastModifiedDate    DateTime
  goLiveOnShelfDate   DateTime?
  expirySunsetDate    DateTime?
  archiveStatus       String
  createdByName       String
  createdByUserId     String?
  createdByUser       User?                            @relation("ArchiveArtworkMetadataCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedByName      String
  approvedByUserId    String?
  approvedByUser      User?                            @relation("ArchiveArtworkMetadataApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt          DateTime?
  clientBrandOwner    String
  regulatoryClearance String?
  fontsUsed           String
  imagesPhotography   String
  illustrationsIcons  String
  colourCodes         String
  thirdPartyLogosIp   String?
  supplierPrinter     String?
  outputFilesList     String?
  printProofRef       String?
  packagingDielineRef String?
  changeLog           String
  relatedArtworks     String?
  briefSpecLink       String?
  generalNotes        String?
  archivedById        String
  archivedBy          User                             @relation("ArchiveArtworkMetadataArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  @@index([projectId])
  @@index([manualArchiveFileId])
  @@index([sourceAttachmentId])
  @@index([artworkId])
  @@index([titleWorkingName])
  @@index([brandSubBrand])
  @@index([artworkType])
  @@index([languageMarket])
  @@index([archiveStatus])
  @@index([archivedById])
}

enum ArchiveArtworkMetadataSourceType {
  PROJECT_FINAL_FILE
  DIRECT_UPLOAD
}

model ProjectCompletionWorkflow {
  id                              String                      @id @default(cuid())
  projectId                       String                      @unique
  project                         Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvalRequired                Boolean?
  approvalStatus                  ProjectCompletionStepStatus @default(NOT_STARTED)
  approvalContactUserId           String?
  approvalContactUser             User?                       @relation("ProjectCompletionApprovalContact", fields: [approvalContactUserId], references: [id], onDelete: SetNull)
  approvalNote                    String?
  approvalSelectedArchivedFileIds String[]                    @default([])
  approvalSelectedProjectFileIds  String[]                    @default([])
  approvalRequestedAt             DateTime?
  approvalCompletedAt             DateTime?
  copyrightRequired               Boolean?
  copyrightStatus                 ProjectCompletionStepStatus @default(NOT_STARTED)
  copyrightContactUserId          String?
  copyrightContactUser            User?                       @relation("ProjectCompletionCopyrightContact", fields: [copyrightContactUserId], references: [id], onDelete: SetNull)
  copyrightNote                   String?
  copyrightRequestedAt            DateTime?
  copyrightCompletedAt            DateTime?
  invoiceRequired                 Boolean?
  invoiceStatus                   ProjectCompletionStepStatus @default(NOT_STARTED)
  invoiceContactUserId            String?
  invoiceContactUser              User?                       @relation("ProjectCompletionInvoiceContact", fields: [invoiceContactUserId], references: [id], onDelete: SetNull)
  invoiceNote                     String?
  invoiceRequestedAt              DateTime?
  invoiceCompletedAt              DateTime?
  completedAt                     DateTime?
  documents                       ProjectCompletionDocument[]
  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt

  @@index([approvalStatus])
  @@index([copyrightStatus])
  @@index([invoiceStatus])
  @@index([approvalContactUserId])
  @@index([copyrightContactUserId])
  @@index([invoiceContactUserId])
}

model ProjectCompletionDocument {
  id               String                        @id @default(cuid())
  projectId        String
  project          Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowId       String
  workflow         ProjectCompletionWorkflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  type             ProjectCompletionDocumentType
  originalFileName String
  archiveFileName  String
  mimeType         String
  fileSize         Int
  bucket           String
  storageKey       String                        @unique
  uploadedById     String
  uploadedBy       User                          @relation("ProjectCompletionDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt       DateTime
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@unique([workflowId, type])
  @@index([projectId, type, uploadedAt])
  @@index([uploadedById])
}

model ManualArchiveFile {
  id                  String                                @id @default(cuid())
  fileName            String
  originalFileName    String
  projectName         String?
  projectCreatedBy    String?
  archiveCategoryId   String?
  archiveCategory     ArchiveCategory?                      @relation(fields: [archiveCategoryId], references: [id], onDelete: SetNull)
  projectDate         DateTime?
  mimeType            String
  fileSize            Int
  bucket              String
  storageKey          String                                @unique
  status              AttachmentStatus                      @default(UPLOADING)
  uploadedById        String
  uploadedBy          User                                  @relation("ManualArchiveFileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  assetTags           ManualArchiveFileAssetTagAssignment[]
  artworkMetadata     ArchiveArtworkMetadata?
  userArchiveAccesses UserArchiveAssetAccess[]              @relation("UserArchiveAssetAccessManualArchiveFile")
  shareLinks          ArchiveFileShareLink[]
  uploadedAt          DateTime                              @default(now())
  createdAt           DateTime                              @default(now())
  updatedAt           DateTime                              @updatedAt

  @@index([archiveCategoryId, uploadedAt])
  @@index([uploadedById])
  @@index([status])
}

model ArchiveFileShareLink {
  id                    String               @id @default(cuid())
  tokenHash             String               @unique
  archivedProjectFileId String?
  archivedProjectFile   ArchivedProjectFile? @relation(fields: [archivedProjectFileId], references: [id], onDelete: Cascade)
  manualArchiveFileId   String?
  manualArchiveFile     ManualArchiveFile?   @relation(fields: [manualArchiveFileId], references: [id], onDelete: Cascade)
  createdById           String
  createdBy             User                 @relation("ArchiveFileShareLinkCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt             DateTime
  revokedAt             DateTime?
  downloadCount         Int                  @default(0)
  lastDownloadedAt      DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([archivedProjectFileId])
  @@index([manualArchiveFileId])
  @@index([createdById])
  @@index([expiresAt])
}

model ManualLibraryAsset {
  id                          String                            @id @default(cuid())
  assetName                   String
  originalFileName            String
  createdByName               String?
  description                 String?
  category                    String?
  mimeType                    String
  fileSize                    Int
  bucket                      String
  storageKey                  String                            @unique
  status                      AttachmentStatus                  @default(UPLOADING)
  uploadedById                String
  uploadedBy                  User                              @relation("ManualLibraryAssetUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  assetTags                   ManualLibraryAssetTagAssignment[]
  manualLibraryAssetFavorites ManualLibraryAssetFavorite[]
  uploadedAt                  DateTime                          @default(now())
  createdAt                   DateTime                          @default(now())
  updatedAt                   DateTime                          @updatedAt

  @@index([category, uploadedAt])
  @@index([uploadedById])
  @@index([status])
}

model Notification {
  id           String                  @id @default(cuid())
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  title        String
  message      String
  entityType   NotificationEntityType?
  entityId     String?
  projectId    String?
  stageId      String?
  revisionId   String?
  commentId    String?
  attachmentId String?
  archiveId    String?
  url          String?
  dedupeKey    String?                 @unique
  isRead       Boolean                 @default(false)
  readAt       DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([projectId, createdAt])
  @@index([type, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model CalendarEvent {
  id          String            @id @default(cuid())
  title       String
  details     String?
  startAt     DateTime
  endAt       DateTime
  type        CalendarEventType
  tone        CalendarEventTone
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([startAt])
  @@index([endAt])
  @@index([createdById])
}
